# HEIM secrets — copy to .env and fill in. Loaded automatically at startup.
# Everything here is a SECRET; endpoints/recipients live in config/settings.yaml.

# The investigator agent + the analyst fallback model (required)
ANTHROPIC_API_KEY=

# Primary daily-analyst model (optional — without it the Anthropic fallback is used)
OPENROUTER_API_KEY=

# Telegram bot token (optional — enables approvals, live feed, report pushes)
TELEGRAM_BOT_TOKEN=

# SMTP for report emails (optional — for Gmail use an app password)
SMTP_USER=
SMTP_PASSWORD=

# Home Assistant Long-Lived Access Token from a dedicated NON-ADMIN user
# (optional — enables the ha_api tool and the report sensor pushes)
HA_TOKEN=

# Proxmox API token from a dedicated auditor-role user, full value:
#   user@pve!tokenid=secret          (optional — enables the proxmox_api tool)
PROXMOX_TOKEN=

# Override the SSH key path from config/hosts/*.yaml (optional)
# HEIM_SSH_KEY=/home/you/.ssh/pam_agent

# Override the config directory (optional; default ./config)
# HEIM_CONFIG=/opt/heim/config
