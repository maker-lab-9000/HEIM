# HEIM secrets — copy to .env and fill in. Loaded automatically at startup.
# Everything here is a SECRET; endpoints/recipients live in config/settings.yaml.

# ---- Deployment identity (non-secret; referenced as ${VAR} from config/) ----
HEIM_SERVER_IP=          # VM running Prometheus/Loki/containers (e.g. 192.168.1.10)
HEIM_PROXMOX_IP=         # the Proxmox hypervisor (only if you monitor Proxmox)
HEIM_HA_IP=              # the Home Assistant VM (only if you monitor HA)
HEIM_OBSERVABILITY_IP=   # the VM HEIM itself runs on (host 'heim'; omit if not monitored)
HEIM_JELLYFIN_IP=        # the Jellyfin LXC container (host 'jellyfin'; empty = not mapped)
HEIM_LLM_IP=             # the llama-server LXC container (host 'llm'; empty = not mapped)
HEIM_ADGUARD_IP=         # the AdGuard Home LXC container, the house's DNS (host 'adguard'; empty = not mapped)
HEIM_SSH_USER=monitoring-agent   # the read-only SSH user on the target host
HEIM_UPTIME_KUMA_URL=    # Uptime Kuma base URL, e.g. http://192.168.1.10:3001 (empty = off)
HEIM_TELEGRAM_CHAT_ID=   # your numeric Telegram chat id
HEIM_EMAIL_TO=you@example.com
HEIM_EMAIL_FROM=you@example.com
# Dead-man's switch ping URL (optional): the daemon GETs it after every
# completed poll cycle, so an external watchdog (healthchecks.io, Uptime Kuma
# push monitor, HA webhook) alerts when HEIM's own host dies. Empty = disabled.
HEIM_DEADMAN_URL=
# Weekly security audit: the ports you have reviewed and accept on the audited
# host (ubuntu-server), so the audit flags only NEW all-interfaces listeners.
# "port[:label]" items, comma-separated, matched by port (TCP and UDP). :22 is
# always expected. Kept here, not in git, because it is your host's service
# inventory. Unset = every listener except :22 is flagged. Example:
# HEIM_AUDIT_EXPECTED_PORTS=9090:prometheus,9100:node_exporter,3100:loki,8081:cadvisor
HEIM_AUDIT_EXPECTED_PORTS=
# Tooling feedback → GitHub issues (optional; empty = off): the repo HEIM files
# its agents' tool suggestions in, as "owner/name".
HEIM_GITHUB_REPO=
# HEIM_SSH_KEY_FILE=/home/you/.ssh/pam_agent   # docker-compose: host path of the SSH key

# ---- Secrets ----------------------------------------------------------------
# The investigator agent + the analyst fallback model (required)
ANTHROPIC_API_KEY=

# Primary daily-analyst model (optional — without it the Anthropic fallback is used)
OPENROUTER_API_KEY=
HEIM_LLAMACPP_URL=       # llama-server in CT 111, e.g. http://<llm ip>:8180/v1: the analyst's last fallback (empty = off)
HEIM_LLAMACPP_KEY=       # that llama-server's API key (its --api-key)

# Uptime Kuma API key (optional — Settings → API Keys; needed for its /metrics)
UPTIME_KUMA=

# Telegram bot token (optional — enables approvals, live feed, report pushes)
TELEGRAM_BOT_TOKEN=

# GitHub, for tooling-feedback issues (optional). Two fine-grained tokens,
# each limited to the HEIM_GITHUB_REPO repository only:
#   READ  — Issues: read-only. The agents' github_issues tool; keeps them read-only.
#   write — Issues: read and write. Only the daemon's poster uses it.
HEIM_GITHUB_READ_TOKEN=
HEIM_GITHUB_TOKEN=

# SMTP for report emails (optional — for Gmail use an app password)
SMTP_USER=
SMTP_PASSWORD=

# Home Assistant Long-Lived Access Token from a dedicated NON-ADMIN user
# (optional — enables the agent's read-only ha_api tool)
HA_TOKEN=
# Separate ADMIN-user token for pushing sensor.pam_* report entities — HA only
# lets administrators write states via the REST API. Optional; without it the
# pushes fall back to HA_TOKEN (and fail with 401 if that user is non-admin).
HA_PUSH_TOKEN=

# Proxmox API token from a dedicated auditor-role user, full value:
#   user@pve!tokenid=secret          (optional — enables the proxmox_api tool)
PROXMOX_TOKEN=

# Override the SSH key path from config/hosts/*.yaml (optional)
# HEIM_SSH_KEY=/home/you/.ssh/pam_agent

# Override the config directory (optional; default ./config)
# HEIM_CONFIG=/opt/heim/config
