<!doctype html><html><body style="margin:0;padding:0;background:#eef1f7;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#eef1f7;padding:18px 0;"><tr><td align="center">
<table width="720" cellpadding="0" cellspacing="0" style="max-width:720px;width:100%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica,Arial,sans-serif;">

<tr><td style="background:linear-gradient(135deg,#0f172a,#1e293b);border-radius:16px 16px 0 0;padding:22px 24px;">
  <table width="100%"><tr>
    <td><div style="font-size:19px;font-weight:800;color:#fff;">🩺 Homelab Health Report</div>
        <div style="font-size:12px;color:#94a3b8;margin-top:3px;">{{ generated_at }} · hosts: {{ hosts|join(', ') }}</div></td>
    <td align="right" valign="top"><span style="display:inline-block;padding:4px 12px;border-radius:999px;background:{{ overall_color }};color:#fff;font-size:12px;font-weight:700;text-transform:uppercase;">{{ overall }}</span></td>
  </tr></table>
</td></tr>

<tr><td style="background:#fff;padding:18px 24px;">
  {% if headline %}<div style="font-size:15px;font-weight:700;color:#0f172a;margin-bottom:6px;">{{ headline }}</div>{% endif %}
  {% if executive %}<p style="margin:6px 0 14px;font-size:13px;color:#334155;line-height:1.6;">{{ executive }}</p>{% endif %}

  <div style="margin:10px 0;padding:10px 14px;background:#f8fafc;border:1px solid #e5e9f2;border-radius:10px;font-size:13px;color:#334155;">
    🆕 {{ counts.new }} new · 🔄 {{ counts.ongoing }} ongoing · ✅ {{ counts.resolved }} resolved · {{ counts.open }} open total
    {% for i in incidents_new %}<div style="margin-top:6px;">🆕 <strong>{{ i.host }}</strong> — {{ i.metric }} ({{ i.severity }})</div>{% endfor %}
    {% for i in incidents_resolved %}<div style="margin-top:6px;">✅ <strong>{{ i.host }}</strong> — {{ i.metric }} resolved</div>{% endfor %}
  </div>

  <h2 style="font-size:15px;color:#0f172a;margin:18px 0 8px;border-bottom:1px solid #e5e9f2;padding-bottom:4px;">Categories</h2>
  <table width="100%" cellpadding="6" cellspacing="0" style="font-size:12px;color:#334155;">
  {% for name, cat in categories.items() %}
    <tr style="border-bottom:1px solid #f1f5f9;">
      <td width="18">{{ {'ok':'✅','warn':'⚠️','crit':'🔴'}.get(cat.status, 'ℹ️') }}</td>
      <td width="110" style="font-weight:700;">{{ name }}</td>
      <td>{{ cat.insight }}</td>
    </tr>
  {% endfor %}
  </table>

  {% if findings %}
  <h2 style="font-size:15px;color:#0f172a;margin:18px 0 8px;border-bottom:1px solid #e5e9f2;padding-bottom:4px;">Findings ({{ findings|length }})</h2>
  {% for f in findings %}
  <div style="margin:8px 0;padding:10px 14px;background:#fffbeb;border:1px solid #fde68a;border-radius:10px;">
    <div style="font-size:13px;font-weight:700;color:#0f172a;">{{ {'critical':'🔴','warning':'⚠️','info':'ℹ️'}.get(f.severity,'ℹ️') }} {{ f.host }} — {{ f.summary or f.metric }}</div>
    <div style="font-size:12px;color:#334155;margin-top:4px;line-height:1.55;">{{ f.detail }}</div>
    {% if f.recommendation %}<div style="font-size:12px;color:#166534;margin-top:4px;">→ {{ f.recommendation }}</div>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if top_alerts %}
  <h2 style="font-size:15px;color:#0f172a;margin:18px 0 8px;border-bottom:1px solid #e5e9f2;padding-bottom:4px;">Top metric alerts</h2>
  <table width="100%" cellpadding="5" cellspacing="0" style="font-size:12px;color:#334155;">
    <tr style="color:#64748b;text-align:left;"><th></th><th>Host</th><th>Metric</th><th>Current</th><th>Δ 3d</th></tr>
    {% for a in top_alerts %}
    <tr style="border-bottom:1px solid #f1f5f9;">
      <td>{{ flag_icon.get(a.sev, a.sev) }}</td><td>{{ a.host }}</td>
      <td>{{ a.label }}{% if a.name %} ({{ a.name }}){% endif %}</td>
      <td>{{ a.current }} {{ a.unit }}</td>
      <td>{% if a.changePct is not none %}{{ a.changePct }}%{% else %}—{% endif %}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if watchlist %}
  <h2 style="font-size:15px;color:#0f172a;margin:18px 0 8px;border-bottom:1px solid #e5e9f2;padding-bottom:4px;">Watchlist</h2>
  <ul style="margin:6px 0;padding-left:20px;font-size:12px;color:#334155;line-height:1.6;">
    {% for w in watchlist %}<li>{{ w }}</li>{% endfor %}
  </ul>
  {% endif %}
</td></tr>

<tr><td style="background:#fff;padding:0 24px 18px;border-radius:0 0 16px 16px;">
  <div style="padding-top:12px;border-top:1px solid #e5e9f2;font-size:11px;color:#94a3b8;line-height:1.6;">
    Generated by HEIM (Homelab Event & Incident Monitor). Trends over a 3-day window; thresholds are heuristic and analysis is automated —
    verify critical findings before acting.{% if na_queries %} {{ na_queries }} queries returned no data this run.{% endif %}
  </div>
</td></tr>
</table></td></tr></table></body></html>
