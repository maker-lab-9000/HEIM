<!doctype html><html><body style="margin:0;padding:0;background:#eef1f7;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#eef1f7;padding:18px 0;"><tr><td align="center">
<table width="680" cellpadding="0" cellspacing="0" style="max-width:680px;width:100%;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica,Arial,sans-serif;">
<tr><td style="background:linear-gradient(135deg,#0f172a,#1e293b);border-radius:16px 16px 0 0;padding:22px 24px;">
  <table width="100%"><tr>
    <td><div style="font-size:19px;font-weight:800;color:#fff;">🔍 Root-Cause Investigation</div>
        <div style="font-size:12px;color:#94a3b8;margin-top:3px;">host: {{ host }} · triggered {{ generated_at }} · agent: Claude via HEIM</div></td>
    <td align="right" valign="top">
      {% if incomplete %}<span style="display:inline-block;padding:3px 10px;border-radius:999px;background:#d97706;color:#fff;font-size:11px;font-weight:700;text-transform:uppercase;">incomplete</span>
      {% else %}<span style="display:inline-block;padding:3px 10px;border-radius:999px;background:#16a34a;color:#fff;font-size:11px;font-weight:700;text-transform:uppercase;">complete</span>{% endif %}
    </td>
  </tr></table>
</td></tr>
<tr><td style="background:#fff;padding:18px 24px;border-radius:0 0 16px 16px;">
  <div style="font-size:13px;color:#334155;line-height:1.65;">{{ body }}</div>
  <div style="margin-top:20px;padding-top:12px;border-top:1px solid #e5e9f2;font-size:11px;color:#94a3b8;line-height:1.6;">
    {{ input_tokens }} input · {{ output_tokens }} output tokens · {{ n_steps }} tool calls (exact, from API usage).
    Automated agentic investigation; commands executed read-only via guarded tools and audit-logged.
    Verify root-cause findings and remediation before acting on production systems.
  </div>
</td></tr>
</table></td></tr></table></body></html>
